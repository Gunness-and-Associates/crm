includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - app
        - routes
    # Zero-baseline at level max. Scope is app + routes for now; first-party migrations, factories and
    # seeders join analysis as they are authored (Z-1.2+). Third-party published migrations (e.g. spatie
    # permission) read config() as mixed and are intentionally not analysed.
    ignoreErrors:
        # These traits are used by Tests\Fixtures\ContactableFixture (tests/ is outside the analysed
        # paths on purpose), not dead code.
        -
            message: '#is used zero times and is not analysed#'
            paths:
                - app/Models/Concerns/*
                - app/Support/Acl/HasAcl.php
