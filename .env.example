APP_NAME="crmga CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Target engine is MySQL 8 / MariaDB (utf8mb4). Create the database, then set credentials in .env (never here).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=newcrmga
DB_USERNAME=root
DB_PASSWORD=

# Z-6.1 ETL only, run locally against a copy — never production (BACKEND_BRIEF §13).
# Grant this user SELECT only on the legacy database; crm:migrate-legacy never writes
# through this connection.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

# Path to the legacy SuiteCRM install's public/legacy directory, read-only,
# used only by crm:import-studio-metadata's layout import to read *viewdefs.php.
LEGACY_PHP_ROOT=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Z-8.2 — comma-separated. In production this is the real root domain (e.g.
# crm.example.com) so "acme.crm.example.com" resolves as a tenant domain.
# Needs wildcard DNS + a matching TLS cert — an infra/ops prerequisite.
CENTRAL_DOMAINS=127.0.0.1,localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Local/CI default to database-backed cache and queue so no Redis is required to boot or migrate.
# Production runs Redis + Horizon (set CACHE_STORE=redis, QUEUE_CONNECTION=redis) — see the README.
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis is used so no phpredis PHP extension is required (Windows-friendly).
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Per-company SMTP is configured at runtime from the settings table, not here (tenancy rule 3).
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
